[Unit]
Description=scorefollow OMR and practice analysis API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/n/scorefollow
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/ubuntu/.config/scorefollow-analysis.env
ExecStart=/usr/bin/python3 -m analysis_service.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
